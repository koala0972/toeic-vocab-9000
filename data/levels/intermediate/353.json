            "zh-TW": "公司提倡包容性的職場環境，歡迎各種背景的員工。"
          }
        },
        {
          "en": "Our new leadership programme is more inclusive than the previous one.",
          "highlight": [
            "more inclusive"
          ],
          "translations": {
            "zh-TW": "我們新的領導力計畫比舊版更具包容性。"
          }
        },
        {
          "en": "The conference fee is $500 inclusive of meals and materials.",
          "highlight": [
            "inclusive"
          ],
          "translations": {
            "zh-TW": "研討會費用為 500 美元，包含餐點與資料。"
          }
        }
      ],
      "synonyms": [
        "comprehensive",
        "all-embracing",
        "broad"
      ],
      "antonyms": [
        "exclusive",
        "restrictive"
      ],
      "phrases": [
        "inclusive of",
        "inclusive culture",
        "inclusive package",
        "fully inclusive"
      ]
    },
