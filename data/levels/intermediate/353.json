      "id": "B1-353-001",
      "level": 353,
      "tier": "intermediate",
      "cefr": "B1",
      "toeic_score_min": 650,
      "word": "ideally",
      "pos": [
        "adverb"
      ],
      "conjugations": {},
      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "ideally",
          "definition": "adv. 理想地、完美地、最適合地"
        }
      ],
      "examples": [
        {
          "en": "Ideally, the new software should launch before the fiscal year ends.",
          "highlight": [
            "Ideally"
          ],
          "translations": {
            "zh-TW": "最理想的情況是，新軟體應該在會計年度結束前上線。"
          }
        },
        {
          "en": "The candidate suited the role ideally, combining technical skill with leadership.",
          "highlight": [
            "ideally"
          ],
          "translations": {
            "zh-TW": "這位候選人完美契合這個職位，兼具技術能力與領導特質。"
          }
        },
        {
          "en": "Ideally located near the airport, the hotel attracts business travellers.",
          "highlight": [
            "Ideally"
          ],
          "translations": {
            "zh-TW": "飯店位於機場附近的地點理想，吸引了商務旅客。"
          }
        }
      ],
      "synonyms": [
        "perfectly",
        "optimally",
        "preferably"
      ],
      "antonyms": [
        "poorly",
        "badly"
      ],
      "phrases": [
        "ideally suited",
        "ideally located",
        "ideally positioned"
      ]
    },
