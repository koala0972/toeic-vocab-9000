      "domain": "measure",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "liter",
          "definition": "n. 公升（容量單位）"
        }
      ],
      "examples": [
        {
          "en": "The factory consumes about five thousand liters of diesel every month.",
          "highlight": [
            "liters"
          ],
          "translations": {
            "zh-TW": "這座工廠每月消耗大約五千公升的柴油。"
          }
        },
        {
          "en": "A liter of bottled water costs roughly one dollar at the convenience store.",
          "highlight": [
            "liter"
          ],
          "translations": {
            "zh-TW": "便利商店裡一公升瓶裝水大約要一美元。"
          }
        },
        {
          "en": "Engineers measured the tank capacity in liters before refilling the coolant.",
          "highlight": [
            "liters"
          ],
          "translations": {
            "zh-TW": "工程師在補充冷卻液之前，用公升測量了油槽容量。"
          }
        }
      ],
      "synonyms": [
        "litre",
        "cubic decimeter"
      ],
      "antonyms": [],
      "phrases": [
        "per liter",
        "one liter",
        "liter of water"
      ]
