      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "recession",
          "definition": "n. 經濟衰退、蕭條"
        }
      ],
      "examples": [
        {
          "en": "The recession forced many small businesses to shut down within months.",
          "highlight": [
            "recession"
          ],
          "translations": {
            "zh-TW": "經濟衰退迫使許多小型企業在幾個月內關門。"
          }
        },
        {
          "en": "Economists warn that consecutive recessions could reshape the global market.",
          "highlight": [
            "recessions"
          ],
          "translations": {
            "zh-TW": "經濟學家警告，連續的經濟衰退可能會重塑全球市場。"
          }
        },
        {
          "en": "Consumer spending typically falls during a recession and rebounds slowly afterward.",
          "highlight": [
            "recession"
          ],
          "translations": {
            "zh-TW": "在經濟衰退期間，消費支出通常會下降，之後才會緩慢回升。"
          }
        }
      ],
      "synonyms": [
        "downturn",
        "slump",
        "depression"
      ],
      "antonyms": [
        "boom",
        "recovery"
      ],
      "phrases": [
        "economic recession",
        "in recession",
        "global recession"
      ]
    },
