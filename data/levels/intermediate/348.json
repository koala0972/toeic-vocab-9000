      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "authorization",
          "definition": "n. 授權、許可、批准"
        }
      ],
      "examples": [
        {
          "en": "You will need written authorization from your manager before submitting the expense claim.",
          "highlight": [
