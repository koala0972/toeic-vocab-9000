        {
          "en": "Multiple authorizations are required to access confidential client records.",
          "highlight": [
            "authorizations"
          ],
          "translations": {
            "zh-TW": "存取機密客戶資料需要多重授權。"
          }
        },
        {
          "en": "The authorization process typically takes three to five business days.",
          "highlight": [
            "authorization"
          ],
          "translations": {
            "zh-TW": "授權審核流程通常需要三到五個工作天。"
          }
        }
