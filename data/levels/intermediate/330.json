        {
          "en": "I do my laundry every Sunday morning so my uniforms are ready for the workweek.",
          "highlight": [
            "laundry"
          ],
          "translations": {
            "zh-TW": "我每個星期天早上洗衣服，這樣制服就能為接下來的工作日準備好。"
          }
