      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "laundry",
          "definition": "n. 待洗或洗好的衣服、洗衣店、洗衣房"
        }
      ],
      "examples": [
        {
          "en": "The hotel offers same-day laundry service for business travelers who need fresh shirts before meetings.",
          "highlight": [
            "laundry"
