      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "null",
          "definition": "a. 無效的、無價值的；n. 零、空值（電腦科學用語）"
        }
      ],
      "examples": [
        {
          "en": "Leaving that null usually avoids a confusing error page.",
          "highlight": [
            "null"
          ],
          "translations": {
            "zh-TW": "把該欄位留為空值通常能避免出現令人困惑的錯誤頁面。"
          }
        },
        {
          "en": "If the signature is null, the system blocks the transaction.",
          "highlight": [
            "null"
          ],
          "translations": {
            "zh-TW": "若簽章為空值，系統會封鎖這筆交易。"
          }
        },
        {
          "en": "Researchers try to reject the null when designs allow stronger claims.",
          "highlight": [
            "null"
          ],
          "translations": {
            "zh-TW": "當研究設計支援更強的論斷時，研究者會試圖否證虛無假說。"
          }
        }
      ],
      "synonyms": [
        "void",
        "invalid",
        "zero"
      ],
      "antonyms": [
        "valid"
      ],
      "phrases": [
        "null value",
        "null and void",
        "null hypothesis",
        "set to null"
      ]
