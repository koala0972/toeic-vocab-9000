      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "videoconference",
          "definition": "n. 視訊會議  v. 透過視訊開會"
        }
      ],
      "examples": [
        {
          "en": "The team scheduled a videoconference to discuss the quarterly budget.",
          "highlight": [
            "videoconference"
