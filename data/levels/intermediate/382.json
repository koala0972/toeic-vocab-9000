      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "layoff",
          "definition": "n. 臨時解雇、裁員  (活動、操作等的) 停止期間"
        }
      ],
      "examples": [
        {
          "en": "The company announced a layoff of two hundred factory workers due to declining sales.",
