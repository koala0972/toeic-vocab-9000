      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "internationally",
          "definition": "adv. 國際性地、在國際間"
        }
      ],
      "examples": [
        {
          "en": "Our products are sold internationally through distributors in over forty countries.",
          "highlight": [
            "internationally"
          ],
          "translations": {
            "zh-TW": "我們的產品透過四十多個國家的經銷商在國際間銷售。"
          }
        },
        {
          "en": "She is internationally recognized as a leading authority on climate policy.",
          "highlight": [
            "internationally"
          ],
          "translations": {
            "zh-TW": "她在氣候政策領域是國際公認的權威。"
          }
        },
        {
          "en": "The firm expanded internationally after securing its first contract in Asia.",
          "highlight": [
            "internationally"
          ],
          "translations": {
            "zh-TW": "這家公司在亞洲拿到第一份合約後便開始向國際擴展。"
          }
        }
      ],
      "synonyms": [
        "globally",
        "worldwide",
        "abroad"
      ],
      "antonyms": [
        "domestically",
        "locally"
      ],
      "phrases": [
        "internationally recognized",
        "known internationally",
        "compete internationally"
      ]
    },
