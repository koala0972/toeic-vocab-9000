      "domain": "business",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "subscriber",
          "definition": "n. 訂戶、訂閱者、定期訂購者"
        }
      ],
      "examples": [
        {
          "en": "Our streaming service gained over fifty thousand new subscribers this quarter.",
          "highlight": [
            "subscribers"
          ],
          "translations": {
            "zh-TW": "我們的串流服務本季增加了超過五萬名新訂閱者。"
          }
        },
        {
          "en": "As a long-time subscriber to the financial newsletter, Mr. Lee receives the report every Monday.",
          "highlight": [
            "subscriber"
          ],
          "translations": {
            "zh-TW": "身為該財經電子報的長期訂閱者，李先生每週一都會收到報告。"
          }
        },
        {
          "en": "The telecom company offered a discount to reward its most loyal subscribers.",
          "highlight": [
            "subscribers"
          ],
          "translations": {
            "zh-TW": "這家電信公司提供折扣來回饋最忠實的訂戶。"
          }
        }
      ],
      "synonyms": [
        "member",
        "customer",
        "patron"
      ],
      "antonyms": [
        "unsubscriber",
        "non-subscriber"
      ],
      "phrases": [
        "subscriber base",
        "paid subscriber",
        "subscriber growth",
        "newsletter subscriber"
      ]
