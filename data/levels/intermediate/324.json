      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "frustrate",
          "definition": "v. 使沮喪、挫敗、阻撓、令人灰心"
        }
      ],
      "examples": [
        {
          "en": "The constant delays frustrated the project team and pushed back the launch date.",
          "highlight": [
            "frustrated"
          ],
          "translations": {
            "zh-TW": "持續的延遲讓專案團隊感到挫折，並使上市日期往後推遲。"
          }
        },
        {
          "en": "Slow internet speed frustrates customers who rely on cloud-based tools for their work.",
          "highlight": [
            "frustrates"
          ],
          "translations": {
            "zh-TW": "緩慢的網速讓仰賴雲端工具工作的客戶感到沮喪。"
          }
        },
        {
          "en": "It is frustrating to spend hours on a proposal that never gets approved.",
          "highlight": [
            "frustrating"
          ],
          "translations": {
            "zh-TW": "花好幾個小時撰寫企劃書卻從未獲得批准，實在令人灰心。"
          }
        }
      ],
      "synonyms": [
        "discourage",
        "thwart",
        "disappoint"
      ],
      "antonyms": [
        "encourage",
        "satisfy",
        "please"
      ],
      "phrases": [
        "frustrate someone's plans",
        "feel frustrated",
        "frustrating experience",
        "frustrating situation"
      ]
