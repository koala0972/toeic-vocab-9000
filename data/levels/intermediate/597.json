      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "sql",
          "definition": "n. 結構化查詢語言（Structured Query Language，用於關聯式資料庫的程式語言）"
        }
      ],
      "examples": [
        {
          "en": "The analyst wrote an sql query to extract last month's sales data.",
          "highlight": [
            "sql"
          ],
          "translations": {
            "zh-TW": "分析師寫了一段 結構化查詢語言查詢，擷取上個月的銷售資料。"
          }
        },
        {
          "en": "Modern web apps execute thousands of sqls per minute against the database.",
          "highlight": [
            "sqls"
          ],
          "translations": {
            "zh-TW": "現代網頁應用程式每分鐘對資料庫執行數千次結構化查詢語言指令。"
          }
        },
        {
          "en": "She mastered sql while working as a database administrator.",
          "highlight": [
            "sql"
          ],
          "translations": {
            "zh-TW": "她在擔任資料庫管理員期間精通了結構化查詢語言。"
          }
        }
      ],
      "synonyms": [
        "Structured Query Language",
        "database query language"
      ],
