      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "spouse",
          "definition": "n. 配偶（指丈夫或妻子）"
        }
      ],
      "examples": [
        {
          "en": "Employees may add a spouse to their health insurance plan at no extra cost.",
          "highlight": [
            "spouse"
