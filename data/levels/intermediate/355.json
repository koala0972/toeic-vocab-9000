          "highlight": [
            "spouses"
          ],
          "translations": {
            "zh-TW": "兩位配偶都必須在聯合報稅單上簽名後才能送出。"
          }
        },
        {
          "en": "The company offers paid leave to an employee whose spouse is hospitalized.",
          "highlight": [
            "spouse"
          ],
          "translations": {
            "zh-TW": "公司提供帶薪休假給配偶住院的員工。"
          }
