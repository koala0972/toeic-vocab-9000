      "word": "corruption",
      "phonetic": "",
      "pos": [
        "noun"
      ],
      "conjugations": {},
      "domain": "politics",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "corruption",
          "definition": "n. 貪污、腐敗；堕落；舞弊"
        }
      ],
      "examples": [
        {
          "en": "A new anti-corruption unit began raiding suppliers suspected of bid rigging.",
          "highlight": [
            "corruption"
          ],
          "translations": {
            "zh-TW": "新的反貪單位開始突擊搜查涉嫌圍標的供應商。"
          }
        },
        {
          "en": "Petty corruption can drain a quarter of an aid budget, audits reveal.",
          "highlight": [
            "corruption"
          ],
          "translations": {
            "zh-TW": "查帳發現，基層貪瀆一筆就會吃掉援助預算的四分之一。"
          }
        },
        {
          "en": "Because corruption is so systemic, farmer subsidies often vanish before sowing season.",
          "highlight": [
            "corruption"
          ],
          "translations": {
            "zh-TW": "因為腐敗已系統化，農民補助常常在播種季節之前就消失。"
          }
        }
      ],
      "synonyms": [
        "bribery",
        "graft",
        "malfeasance"
      ],
      "antonyms": [
        "integrity"
      ],
      "phrases": [
        "political corruption",
        "anti-corruption",
        "police corruption",
        "root out corruption"
      ]
