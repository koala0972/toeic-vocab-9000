      "domain": "government",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "regulation",
          "definition": "n. 規章；法規；規則；管理、控制"
        }
      ],
      "examples": [
        {
          "en": "Strict government regulation of the airline industry ensures passenger safety.",
          "highlight": [
            "regulation"
          ],
          "translations": {
            "zh-TW": "政府對航空業的嚴格規範確保了乘客安全。"
          }
        },
        {
          "en": "Several new regulations on food labelling will take effect next year.",
          "highlight": [
            "regulations"
          ],
          "translations": {
            "zh-TW": "幾項新的食品標示規定將於明年生效。"
          }
        },
        {
          "en": "By regulating the financial markets more tightly the central bank hopes to reduce risk.",
          "highlight": [
            "regulating"
          ],
          "translations": {
            "zh-TW": "透過更嚴格地規範金融市場，央行希望能降低風險。"
          }
        }
      ],
      "synonyms": [
        "rule",
        "law",
        "directive"
      ],
      "antonyms": [
        "deregulation"
      ],
      "phrases": [
        "government regulation",
        "safety regulation",
        "regulation policy",
        "comply with regulations"
      ]
    },
