      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "acceptance",
          "definition": "n. 接受、接納、贊同；容忍"
        }
      ],
      "examples": [
        {
          "en": "The manager's acceptance of the proposal surprised everyone in the room.",
          "highlight": [
            "acceptance"
          ],
          "translations": {
            "zh-TW": "主管對這項提案的接受，讓在場所有人都感到驚訝。"
          }
        },
        {
          "en": "The company received over fifty acceptances for its new internship program.",
          "highlight": [
            "acceptances"
          ],
          "translations": {
            "zh-TW": "公司的新實習計畫收到超過五十個錄取通知的接受回覆。"
          }
        },
        {
          "en": "Social acceptance of remote work has grown significantly since the pandemic.",
          "highlight": [
            "acceptance"
          ],
          "translations": {
            "zh-TW": "遠端工作的社會接受度在疫情之後大幅提升。"
          }
        }
