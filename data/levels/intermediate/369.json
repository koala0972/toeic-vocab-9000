      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "generator",
          "definition": "n. 發電機、產生器"
        }
      ],
      "examples": [
        {
          "en": "The hospital installed a backup generator to keep critical equipment running during power outages.",
          "highlight": [
            "generator"
          ],
          "translations": {
            "zh-TW": "醫院安裝了備用發電機，以便在停電期間維持關鍵設備運轉。"
          }
        },
        {
          "en": "Portable generators are essential on construction sites where grid power is unavailable.",
          "highlight": [
            "generators"
          ],
          "translations": {
            "zh-TW": "在無法接入電網的工地，可攜式發電機是不可或缺的。"
          }
        },
        {
          "en": "The factory rents diesel generators by the day whenever demand peaks in summer.",
          "highlight": [
            "generators"
          ],
          "translations": {
            "zh-TW": "夏季用電高峰時，工廠會以日為單位租用柴油發電機。"
          }
