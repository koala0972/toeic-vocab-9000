          "lang_word": "binding",
          "definition": "n. 裝訂、綁定  a. 有約束力的、必須遵守的"
        }
      ],
      "examples": [
        {
          "en": "The contract includes a binding arbitration clause for all disputes.",
          "highlight": [
            "binding"
          ],
          "translations": {
            "zh-TW": "合約中包含一項對所有爭議都有約束力的仲裁條款。"
          }
        },
        {
          "en": "She chose a spiral binding for her thesis so the pages would lie flat.",
          "highlight": [
            "binding"
          ],
          "translations": {
            "zh-TW": "她為論文選擇了螺旋裝訂,這樣書頁才能攤平。"
          }
        },
        {
          "en": "The two partners signed a legally binding agreement last week.",
          "highlight": [
            "binding"
          ],
          "translations": {
            "zh-TW": "兩位合作夥伴上週簽署了一份具有法律約束力的協議。"
          }
        }
      ],
      "synonyms": [
        "obligatory",
        "compulsory",
        "fastening"
      ],
      "antonyms": [
        "nonbinding",
        "optional"
      ],
      "phrases": [
        "binding agreement",
        "binding arbitration",
        "book binding"
      ]
    },
