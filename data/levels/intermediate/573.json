      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "newsletter",
          "definition": "n. 簡訊、電子報、通訊（定期發行給訂閱者的刊物）"
        }
      ],
      "examples": [
        {
          "en": "Our company sends out a monthly newsletter to all subscribers.",
          "highlight": [
            "newsletter"
          ],
          "translations": {
            "zh-TW": "我們公司每月向所有訂閱者發送一份電子報。"
          }
        },
        {
          "en": "The marketing team drafts two newsletters each week for different audiences.",
          "highlight": [
            "newsletters"
          ],
          "translations": {
            "zh-TW": "行銷團隊每週為不同受眾撰寫兩份電子報。"
          }
        },
        {
          "en": "Please subscribe to our newsletter to receive the latest product updates.",
          "highlight": [
            "newsletter"
          ],
          "translations": {
            "zh-TW": "請訂閱我們的電子報以接收最新的產品消息。"
          }
        }
      ],
      "synonyms": [
        "bulletin",
        "circular",
        "digest"
      ],
      "antonyms": [],
      "phrases": [
        "company newsletter",
        "email newsletter",
        "subscribe to a newsletter"
      ]
    },
