      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "recruitment",
          "definition": "n. 招募、徵才、招聘"
        }
      ],
      "examples": [
        {
          "en": "The company launched a new recruitment campaign to hire software engineers.",
          "highlight": [
