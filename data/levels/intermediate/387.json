          ],
          "translations": {
            "zh-TW": "預算緊縮時，更深入的部門級別行銷成本分析成為必要。"
          }
        },
        {
          "en": "The most departmental review the team has ever conducted revealed hidden hiring costs.",
          "highlight": [
            "most departmental"
          ],
          "translations": {
            "zh-TW": "團隊做過最詳細的部門級別審查暴露了隱藏的招募成本。"
