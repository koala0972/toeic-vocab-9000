      "domain": "business",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "departmental",
          "definition": "a. 部門的、各部門的、分科的"
        }
      ],
      "examples": [
        {
          "en": "Each branch office follows its own departmental policy for expense approvals.",
          "highlight": [
