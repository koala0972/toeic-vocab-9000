      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "nonetheless",
          "definition": "adv. 然而、儘管如此  conj. 雖然如此"
        }
      ],
      "examples": [
        {
          "en": "Sales were nonetheless strong despite a weak holiday season, the report shows.",
          "highlight": [
            "nonetheless"
          ],
          "translations": {
            "zh-TW": "報告顯示，儘管假期需求疲弱，銷售依然強勁。"
          }
        },
        {
          "en": "The candidate lacks formal experience; nonetheless, his portfolio impressed the panel.",
          "highlight": [
            "nonetheless"
          ],
          "translations": {
            "zh-TW": "這位候選人缺乏正式經驗；儘管如此，他的作品集仍令評審印象深刻。"
          }
        },
        {
          "en": "Costs rose sharply this quarter, nonetheless profit margins held steady.",
          "highlight": [
            "nonetheless"
          ],
          "translations": {
            "zh-TW": "本季成本大幅上升，然而利潤率仍保持穩定。"
          }
        }
      ],
      "synonyms": [
        "nevertheless",
        "however",
        "still"
      ],
      "antonyms": [
        "therefore"
      ],
      "phrases": [
        "but nonetheless",
        "nonetheless true",
        "nonetheless important"
      ]
    },
