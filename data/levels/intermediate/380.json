            "circulated"
          ],
          "translations": {
            "zh-TW": "有謠言流傳公司正計畫大規模裁員。"
          }
        },
        {
          "en": "Air is circulated through the ventilation system to keep the office cool.",
          "highlight": [
            "circulating"
          ],
          "translations": {
            "zh-TW": "空氣透過通風系統循環，讓辦公室保持涼爽。"
          }
        }
      ],
      "synonyms": [
        "distribute",
        "spread",
        "circulate"
