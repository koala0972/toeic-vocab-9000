      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "generalization",
          "definition": "n. 概括、一般化、通則"
        }
      ],
      "examples": [
        {
          "en": "The analyst's claim that all startups fail was a misleading generalization.",
          "highlight": [
            "generalization"
          ],
          "translations": {
            "zh-TW": "那位分析師宣稱所有新創公司都會失敗，是個誤導性的概括。"
          }
        },
        {
          "en": "Avoid broad generalizations when reviewing candidates from diverse backgrounds.",
          "highlight": [
            "generalizations"
          ],
          "translations": {
            "zh-TW": "在審查來自不同背景的候選人時，應避免廣泛的概括。"
          }
        },
        {
          "en": "Such an overgeneralization ignores the differences between regional markets.",
          "highlight": [
            "overgeneralization"
          ],
          "translations": {
            "zh-TW": "這種過度概括忽略了區域市場之間的差異。"
          }
        }
      ],
      "synonyms": [
        "oversimplification",
        "broad statement",
        "general rule"
      ],
      "antonyms": [
        "specific",
        "exception",
        "detail"
      ],
      "phrases": [
        "hasty generalization",
        "make a generalization",
        "sweeping generalization",
        "unfair generalization"
      ]
