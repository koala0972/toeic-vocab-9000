      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "streamline",
          "definition": "v. 使流程精簡、提高效率"
        }
      ],
      "examples": [
        {
          "en": "The company plans to streamline its supply chain to reduce delivery times.",
          "highlight": [
            "streamline"
          ],
          "translations": {
            "zh-TW": "公司計畫精簡供應鏈流程以縮短配送時間。"
          }
        },
        {
          "en": "After the audit, the manager streamlined the approval process to boost overall productivity.",
          "highlight": [
            "streamlined"
          ],
          "translations": {
            "zh-TW": "稽核之後，經理簡化了審批流程以提升整體生產力。"
          }
        },
        {
          "en": "Streamlining operations has helped the manufacturer cut costs without sacrificing quality.",
          "highlight": [
            "Streamlining"
          ],
          "translations": {
            "zh-TW": "精簡營運流程已幫助製造商在不犧牲品質的前提下降低成本。"
          }
        }
      ],
      "synonyms": [
        "simplify",
        "optimize",
        "rationalize"
