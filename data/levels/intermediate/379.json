      "examples": [
        {
          "en": "The company sponsors an athletic event every spring to promote employee wellness.",
          "highlight": [
            "athletic"
          ],
          "translations": {
            "zh-TW": "公司每年春天贊助一場體育活動，以推動員工健康。"
          }
        },
        {
          "en": "Between the two candidates, the younger one clearly seems more athletic and recovers faster from injury.",
          "highlight": [
            "more athletic"
          ],
          "translations": {
            "zh-TW": "兩位候選人之間，年紀較輕的那位明顯體格更健壯，受傷後復原也較快。"
          }
        },
        {
          "en": "She was the most athletic student in our class and won three gold medals at the regional games.",
          "highlight": [
            "most athletic"
          ],
          "translations": {
            "zh-TW": "她是我們班上最擅長運動的學生，在區運會拿下了三面金牌。"
          }
        }
      ],
      "synonyms": [
        "sporty",
        "active",
        "vigorous"
      ],
      "antonyms": [
        "unathletic",
        "sedentary"
      ],
      "phrases": [
