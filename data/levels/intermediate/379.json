      "conjugations": {
        "plural": "adapters"
      },
      "domain": "technology",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "adapter",
          "definition": "n. 轉接器、適配器（用於銜接兩種不同規格的裝置或介面）"
        }
      ],
      "examples": [
        {
          "en": "I forgot to pack a power adapter, so my laptop died before the meeting.",
          "highlight": [
            "adapter"
          ],
          "translations": {
            "zh-TW": "我忘了帶電源轉接器，所以筆電在開會前就沒電了。"
          }
        },
        {
          "en": "The IT department ordered ten adapters to connect the new monitors to the old docking stations.",
          "highlight": [
            "adapters"
          ],
          "translations": {
            "zh-TW": "資訊部門訂了十個轉接器，用來把新螢幕接到舊型擴充座。"
          }
        },
        {
          "en": "You will need a special adapter to plug a European appliance into a Taiwanese socket.",
          "highlight": [
            "adapter"
          ],
          "translations": {
            "zh-TW": "你要把歐規電器插到台灣插座上，會需要一個專用轉接器。"
          }
        }
      ],
      "synonyms": [
        "connector",
        "converter",
        "plug"
      ],
      "antonyms": [
        "converter"
      ],
      "phrases": [
        "power adapter",
        "network adapter",
        "plug adapter",
        "adapter card"
      ]
    },
