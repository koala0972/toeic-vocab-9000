          "lang_word": "assurance",
          "definition": "n. 保證、擔保（亦可指保險，尤指人壽保險）"
        }
      ],
      "examples": [
        {
          "en": "The contractor gave us his assurance that the project would be finished by the deadline.",
          "highlight": [
            "assurance"
          ],
          "translations": {
            "zh-TW": "承包商向我們保證專案會在期限前完成。"
          }
        },
        {
          "en": "The CEO's public assurances failed to calm anxious investors after the stock dropped ten percent.",
          "highlight": [
            "assurances"
          ],
          "translations": {
            "zh-TW": "股價下跌一成後，執行長的公開保證仍未能安撫焦慮的投資人。"
          }
        },
        {
          "en": "Our quality assurance team inspects every batch before it leaves the factory.",
          "highlight": [
            "assurance"
          ],
          "translations": {
            "zh-TW": "我們的品質保證團隊會在每批產品出廠前進行檢驗。"
          }
        }
      ],
      "synonyms": [
        "guarantee",
        "pledge",
        "promise"
      ],
      "antonyms": [
        "doubt",
        "uncertainty"
      ],
      "phrases": [
        "quality assurance",
        "life assurance",
        "give assurance",
        "assurance policy"
      ]
