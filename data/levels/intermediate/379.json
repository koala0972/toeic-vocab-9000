          ],
          "translations": {
            "zh-TW": "整修開始前，圖書館員先把舊期的報紙歸檔儲存。"
          }
        },
        {
          "en": "We are archiving every email thread related to the merger to ensure compliance with regulations.",
          "highlight": [
            "archiving"
          ],
          "translations": {
            "zh-TW": "我們正在把與併購案相關的每封郵件串流歸檔，以確保符合法規。"
          }
        }
