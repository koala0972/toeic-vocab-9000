      "id": "B1-379-002",
      "level": 379,
      "tier": "intermediate",
      "cefr": "B1",
      "toeic_score_min": 650,
      "word": "advisable",
      "phonetic": "",
      "pos": [
        "adjective"
      ],
      "conjugations": {
        "comparative": "more advisable",
        "superlative": "most advisable"
      },
      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "advisable",
          "definition": "adj. 明智的、可取的（指某做法值得建議或適當）"
        }
      ],
      "examples": [
        {
          "en": "It is advisable to back up your files before updating the operating system.",
          "highlight": [
            "advisable"
          ],
          "translations": {
            "zh-TW": "在更新作業系統之前先備份檔案是明智之舉。"
          }
        },
        {
          "en": "In high-risk industries, hiring a local consultant is more advisable than relying on online research alone.",
          "highlight": [
            "more advisable"
          ],
          "translations": {
            "zh-TW": "在高風險產業裡，聘請在地顧問比只靠網路搜尋來得更可取。"
          }
        },
        {
          "en": "Of all the options on the table, delaying the product launch would be the most advisable course of action.",
          "highlight": [
            "most advisable"
          ],
          "translations": {
            "zh-TW": "在檯面上所有選項中，延後產品上市會是最明智的做法。"
          }
        }
      ],
      "synonyms": [
        "wise",
        "sensible",
        "prudent"
      ],
      "antonyms": [
        "inadvisable",
        "unwise"
      ],
      "phrases": [
        "highly advisable",
        "it is advisable to",
        "deem advisable",
        "advisable precaution"
      ]
    },
