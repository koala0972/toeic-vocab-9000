      "phonetic": "",
      "pos": [
        "noun"
      ],
      "conjugations": {
        "plural": "bankruptcies"
      },
      "domain": "business",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "bankruptcy",
          "definition": "n. 破產、倒閉（指個人或公司無力償還債務的法律狀態）"
        }
      ],
      "examples": [
        {
          "en": "The retailer filed for bankruptcy after losing three key suppliers in a single quarter.",
          "highlight": [
            "bankruptcy"
          ],
          "translations": {
            "zh-TW": "這家零售商在一季內失去了三家主力供應商，隨後聲請破產。"
          }
        },
        {
          "en": "Recent bankruptcies in the airline industry have pushed ticket prices higher across the region.",
          "highlight": [
            "bankruptcies"
          ],
          "translations": {
            "zh-TW": "航空業近期的幾起破產事件，讓全區機票價格往上推升。"
          }
        },
        {
          "en": "A careful cash-flow plan can help a small business avoid bankruptcy during a market downturn.",
          "highlight": [
            "bankruptcy"
          ],
          "translations": {
            "zh-TW": "一份謹慎的現金流量計畫，能幫助小企業在市場下行時避免破產。"
          }
        }
      ],
      "synonyms": [
        "insolvency",
        "failure",
        "collapse"
      ],
      "antonyms": [
        "solvency",
        "prosperity"
      ],
      "phrases": [
        "file for bankruptcy",
        "declare bankruptcy",
        "avoid bankruptcy",
        "bankruptcy court"
      ]
    },
