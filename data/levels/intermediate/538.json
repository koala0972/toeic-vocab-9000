      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "est",
          "definition": "名詞：東部標準時間（Eastern Standard Time）；也用於形容詞最高級字尾。"
        }
      ],
      "examples": [
        {
          "en": "The meeting is scheduled at 9 am est tomorrow.",
          "highlight": [
            "est"
          ],
          "translations": {
            "zh-TW": "會議訂於明天美東時間上午九點。"
          }
        },
        {
          "en": "Different ests apply depending on the season.",
          "highlight": [
            "ests"
          ],
          "translations": {
            "zh-TW": "不同的東部標準時間會依季節而適用。"
          }
        },
        {
          "en": "Please convert the time from est to gmt before calling.",
          "highlight": [
            "est"
          ],
          "translations": {
            "zh-TW": "請在撥打電話前將時間從美東時間轉換為格林威治時間。"
          }
        }
      ],
      "synonyms": [
        "eastern time",
        "edt"
      ],
      "antonyms": [
        "pst"
      ],
      "phrases": [
        "est time zone",
        "est to pst",
        "eastern standard time"
      ]
    },
