      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "announcement",
          "definition": "n. 公告；宣布；通告；通知"
        }
      ],
      "examples": [
        {
          "en": "The chief executive made a formal announcement about the merger after the closing bell.",
          "highlight": [
            "announcement"
          ],
          "translations": {
            "zh-TW": "執行長在收盤後正式宣布了合併案。"
          }
        },
        {
          "en": "Several staff announcements were posted on the company intranet last week.",
          "highlight": [
            "announcements"
          ],
          "translations": {
            "zh-TW": "幾則人事公告上週張貼於公司內部網路。"
          }
        },
        {
          "en": "By making the announcement early the firm gave investors time to adjust their portfolios.",
          "highlight": [
            "announcement"
          ],
          "translations": {
            "zh-TW": "藉由提早發布公告，公司給了投資人調整投資組合的時間。"
          }
        }
      ],
      "synonyms": [
        "declaration",
        "statement",
        "proclamation"
      ],
      "antonyms": [],
      "phrases": [
        "make an announcement",
        "official announcement",
        "public announcement",
        "announcement of"
      ]
