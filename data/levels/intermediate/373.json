      ],
      "examples": [
        {
          "en": "The factory's unused equipment was sold at auction to free up warehouse space.",
          "highlight": [
            "unused"
          ],
          "translations": {
            "zh-TW": "工廠閒置的設備在拍賣會上售出，以騰出倉庫空間。"
          }
        },
        {
          "en": "Several unused vacation days must be scheduled before the end of the fiscal year.",
          "highlight": [
            "unused"
          ],
          "translations": {
            "zh-TW": "幾天未休的假期必須在會計年度結束前安排休完。"
          }
        },
        {
          "en": "The IT department reclaimed unused software licenses to cut monthly subscription costs.",
          "highlight": [
            "unused"
          ],
          "translations": {
            "zh-TW": "IT 部門回收了未使用的軟體授權，以降低每月訂閱成本。"
          }
        }
