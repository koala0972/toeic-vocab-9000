      "domain": "geography",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "suburban",
          "definition": "adj. 郊區的、郊外的、市郊式的"
        }
      ],
      "examples": [
        {
          "en": "The company relocated its headquarters to a quieter suburban campus last spring.",
          "highlight": [
            "suburban"
          ],
          "translations": {
            "zh-TW": "去年春天公司把總部遷到了更寧靜的郊區園區。"
          }
        },
        {
          "en": "A more suburban lifestyle often appeals to families with young children.",
          "highlight": [
            "more suburban"
          ],
          "translations": {
            "zh-TW": "更偏向郊區的生活方式，往往吸引有年幼子女的家庭。"
          }
        },
        {
          "en": "The most suburban parts of the metro area still rely heavily on private cars.",
          "highlight": [
            "most suburban"
          ],
          "translations": {
            "zh-TW": "整個都會區最具郊區風貌的地段，仍然高度仰賴私家車。"
          }
        }
      ],
      "synonyms": [
        "residential",
        "outlying",
        "pastoral"
      ],
      "antonyms": [
        "urban",
        "metropolitan"
      ],
      "phrases": [
        "suburban area",
        "suburban sprawl",
        "suburban life",
        "suburban commute"
      ]
