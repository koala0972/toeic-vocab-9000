          "lang": "zh-TW",
          "lang_word": "dependence",
          "definition": "n. 依賴、依存、從屬"
        }
      ],
      "examples": [
        {
          "en": "The country's heavy dependence on oil exports worries many economists.",
          "highlight": [
            "dependence"
          ],
          "translations": {
            "zh-TW": "該國對石油出口的高度依賴令許多經濟學家擔憂。"
          }
        },
        {
          "en": "Such dependences on foreign suppliers can disrupt production during a crisis.",
          "highlight": [
            "dependences"
          ],
          "translations": {
            "zh-TW": "在危機期間，這類對外國供應商的依賴可能會打亂生產。"
          }
        },
        {
          "en": "Long-term dependence on painkillers can lead to serious health problems.",
          "highlight": [
            "dependence"
          ],
          "translations": {
            "zh-TW": "長期依賴止痛藥可能會導致嚴重的健康問題。"
          }
        }
      ],
      "synonyms": [
        "reliance",
        "addiction",
        "contingency"
      ],
      "antonyms": [
        "independence",
        "self-sufficiency"
      ],
      "phrases": [
        "dependence on",
        "drug dependence",
        "economic dependence",
        "mutual dependence"
      ]
    },
