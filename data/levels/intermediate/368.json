          "lang_word": "distraction",
          "definition": "n. 分心、注意力分散、令人分心的事物"
        }
      ],
      "examples": [
        {
          "en": "Loud noise from the construction site was a constant distraction during the meeting.",
          "highlight": [
            "distraction"
          ],
          "translations": {
            "zh-TW": "施工現場的巨大噪音在會議期間是不斷令人分心的因素。"
          }
        },
        {
          "en": "Smartphones and social media are among the biggest distractions in the modern workplace.",
          "highlight": [
            "distractions"
          ],
          "translations": {
            "zh-TW": "智慧型手機和社群媒體是現代職場中最令人分心的事物之一。"
          }
        },
        {
          "en": "She used music as a distraction from the stress of preparing for the TOEIC exam.",
          "highlight": [
            "distraction"
          ],
          "translations": {
            "zh-TW": "她用音樂來轉移注意力，紓解準備多益考試的壓力。"
          }
        }
      ],
      "synonyms": [
        "diversion",
        "interruption",
        "disturbance"
      ],
      "antonyms": [
        "focus",
        "concentration"
      ],
      "phrases": [
        "cause a distraction",
        "suffer from distractions",
        "avoid distractions",
        "driving distraction"
      ]
