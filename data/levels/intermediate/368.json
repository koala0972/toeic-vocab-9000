      "conjugations": {
        "plural": "counselors"
      },
      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "counselor",
          "definition": "n. 顧問、參事、法律顧問、輔導員"
        }
      ],
      "examples": [
        {
          "en": "The company hired a financial counselor to help employees plan their retirement.",
          "highlight": [
            "counselor"
          ],
          "translations": {
            "zh-TW": "公司聘請了一位理財顧問，協助員工規劃退休計畫。"
          }
        },
        {
          "en": "Our counselors will guide you through every step of the visa application process.",
          "highlight": [
            "counselors"
          ],
          "translations": {
            "zh-TW": "我們的顧問們將會引導您完成簽證申請的每一個步驟。"
          }
        },
        {
          "en": "She spoke with the school counselor about her daughter's declining grades.",
          "highlight": [
            "counselor"
          ],
          "translations": {
            "zh-TW": "她和學校的輔導員談了她女兒每下愈況的成績。"
          }
        }
      ],
      "synonyms": [
        "advisor",
        "consultant",
        "guide"
      ],
      "antonyms": [
        "client"
      ],
      "phrases": [
        "guidance counselor",
        "financial counselor",
        "marriage counselor",
        "school counselor"
      ]
    },
