      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "debit",
          "definition": "n. 借方、記入借方的款項  v. 將（款項）記入借方、從帳戶扣款"
        }
      ],
      "examples": [
        {
          "en": "A debit of $200 appeared on my bank statement this morning.",
          "highlight": [
            "debit"
          ],
          "translations": {
            "zh-TW": "今天早上我的銀行對帳單上出現了一筆 200 元的借項。"
          }
        },
        {
          "en": "The bank debited the annual fee from my checking account without notice.",
          "highlight": [
            "debited"
          ],
          "translations": {
            "zh-TW": "銀行未經通知就從我的支票帳戶扣除了年費。"
          }
        },
        {
          "en": "By debiting each customer's account automatically, the utility company reduced late payments.",
          "highlight": [
            "debiting"
          ],
          "translations": {
            "zh-TW": "公用事業公司透過自動從每位客戶的帳戶扣款，減少了延遲繳費的情形。"
          }
        }
      ],
      "synonyms": [
        "deduction",
        "withdrawal",
        "charge"
