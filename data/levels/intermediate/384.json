      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "someday",
          "definition": "adv. 有一天、總有一天、未來某個時候"
        }
      ],
      "examples": [
        {
          "en": "Someday I hope to open my own accounting firm in Taipei.",
          "highlight": [
            "Someday"
          ],
          "translations": {
            "zh-TW": "總有一天，我希望能自己在台北開一家會計事務所。"
          }
        },
        {
          "en": "If we keep investing consistently, someday these shares will be worth a fortune.",
          "highlight": [
            "someday"
          ],
          "translations": {
            "zh-TW": "只要我們持續穩定投資，有一天這些股票將會價值不菲。"
          }
        },
        {
          "en": "The CEO told the staff that someday the company would expand into Southeast Asia.",
          "highlight": [
            "someday"
          ],
          "translations": {
            "zh-TW": "執行長告訴員工，有一天公司會擴展到東南亞市場。"
          }
        }
      ],
      "synonyms": [
        "eventually",
        "someday or other",
        "one day"
      ],
      "antonyms": [
        "never"
      ],
      "phrases": [
        "someday soon",
        "hope to see you someday",
        "someday in the future"
      ]
