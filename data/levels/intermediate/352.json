      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "economize",
          "definition": "v. 節約、節省開支；有效地利用資源"
        }
      ],
      "examples": [
        {
          "en": "Families can economize on groceries by planning meals around weekly sales.",
          "highlight": [
            "economize"
          ],
          "translations": {
            "zh-TW": "家庭若依照每週特價來規劃餐點，就能在食品雜貨上節省開支。"
          }
        },
        {
          "en": "Our department economized by switching to digital documents instead of printing.",
          "highlight": [
            "economized"
          ],
          "translations": {
            "zh-TW": "我們部門改用電子文件取代列印，藉此節省開支。"
          }
        },
        {
          "en": "Economizing on energy helps both the household budget and the environment.",
          "highlight": [
            "economizing"
          ],
          "translations": {
            "zh-TW": "在能源上節約，對家庭預算與環境雙方都有幫助。"
          }
        }
      ],
      "synonyms": [
        "save",
        "conserve",
        "cut back",
        "scrimp"
      ],
      "antonyms": [
        "waste",
        "splurge",
        "overspend"
      ],
      "phrases": [
        "economize on expenses",
        "economize on fuel",
        "economize on electricity",
        "economize by doing"
