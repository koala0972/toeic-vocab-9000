          "highlight": [
            "Ontario"
          ],
          "translations": {
            "zh-TW": "本季安大略省的製造業就業成長了百分之四。"
          }
        },
        {
          "en": "Lake Ontario freezes along the shoreline during harsh winters.",
          "highlight": [
            "Ontario"
          ],
          "translations": {
            "zh-TW": "嚴冬時，安大略湖的沿岸水域會結冰。"
          }
        }
