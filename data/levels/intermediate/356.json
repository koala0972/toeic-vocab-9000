        {
          "en": "High fuel consumption has forced the logistics company to raise its delivery fees.",
          "highlight": [
            "consumption"
          ],
          "translations": {
            "zh-TW": "高昂的燃料消耗量迫使這家物流公司調漲配送費用。"
