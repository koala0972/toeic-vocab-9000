      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "webmaster",
          "definition": "n. 網站管理員（負責維護與更新網站的人員）"
        }
      ],
      "examples": [
        {
          "en": "The webmaster updated the site to fix broken links last night.",
          "highlight": [
            "webmaster"
          ],
          "translations": {
            "zh-TW": "網站管理員昨晚更新了網站以修復失效連結。"
          }
