        {
          "en": "If the page does not load, contact the webmaster for assistance.",
          "highlight": [
            "webmaster"
          ],
          "translations": {
            "zh-TW": "若頁面無法載入，請聯絡網站管理員求助。"
          }
        },
        {
          "en": "Experienced webmasters often rotate server logs every week.",
          "highlight": [
            "webmasters"
          ],
          "translations": {
            "zh-TW": "資深的網站管理員通常每週輪替伺服器日誌。"
          }
