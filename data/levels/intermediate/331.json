          "highlight": [
            "afterward"
          ],
          "translations": {
            "zh-TW": "專題演講者後來花了將近一小時為讀者簽書。"
          }
        },
        {
          "en": "Please send the invoice afterward so the accounting team can process it on Monday.",
          "highlight": [
            "afterward"
          ],
          "translations": {
            "zh-TW": "請稍後再寄出發票，這樣會計團隊才能在週一處理。"
          }
        }
      ],
