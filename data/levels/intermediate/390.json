      },
      "domain": "urban-planning",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "overcrowd",
          "definition": "v. 使過度擁擠、擠滿（超出容納量）"
        }
      ],
      "examples": [
        {
          "en": "The city's public housing program overcrowded several neighborhoods within a decade.",
          "highlight": [
            "overcrowded"
          ],
          "translations": {
            "zh-TW": "該市的公共住宅計畫在十年內讓幾個社區變得過度擁擠。"
          }
        },
        {
          "en": "Budget cuts have overcrowded the shelter well beyond its legal capacity.",
          "highlight": [
            "overcrowded"
          ],
          "translations": {
            "zh-TW": "預算刪減使收容所的人數遠遠超過法定容量而過度擁擠。"
          }
        },
        {
          "en": "Overcrowding classrooms directly undermines teacher effectiveness and student performance.",
          "highlight": [
            "Overcrowding"
          ],
          "translations": {
            "zh-TW": "教室過度擁擠會直接削弱教學成效與學生表現。"
          }
        }
      ],
      "synonyms": [
        "jam-pack",
        "cram",
        "congest"
      ],
      "antonyms": [
        "empty",
        "thin out"
      ],
      "phrases": [
        "overcrowded prison",
        "overcrowded classroom",
        "overcrowded bus",
        "overcrowd a room"
      ]
    },
