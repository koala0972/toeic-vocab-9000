      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "auto",
          "definition": "n. 汽車（automobile 的簡稱）"
        }
      ],
      "examples": [
        {
          "en": "The company provides each sales representative with a company auto for client visits.",
          "highlight": [
            "auto"
          ],
          "translations": {
            "zh-TW": "公司提供每位業務代表一輛公務車，以便拜訪客戶。"
          }
        },
        {
          "en": "Several used autos are available in this month's inventory clearance sale.",
          "highlight": [
            "autos"
          ],
          "translations": {
            "zh-TW": "本月庫存清倉特賣中有數輛二手汽車可供選購。"
          }
        },
        {
          "en": "She prefers to lease an auto rather than buy one outright for business travel.",
          "highlight": [
            "auto"
          ],
          "translations": {
            "zh-TW": "她偏好租賃汽車，而不是直接購買以便商務出差使用。"
          }
        }
      ],
