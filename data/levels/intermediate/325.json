      "domain": "finance",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "deduction",
          "definition": "n. 扣除；扣除額；推論"
        }
      ],
      "examples": [
        {
          "en": "The payroll system applies a tax deduction before issuing each paycheck.",
          "highlight": [
            "deduction"
          ],
          "translations": {
            "zh-TW": "薪資系統在發放每張薪資單前會先進行稅額扣除。"
          }
        },
        {
          "en": "Employees may claim deductions for business expenses incurred during overseas assignments.",
          "highlight": [
            "deductions"
          ],
          "translations": {
            "zh-TW": "員工可以申報海外出差期間所產生的業務費用扣除額。"
          }
        },
        {
          "en": "By a simple deduction, the auditor concluded that two invoices had been paid twice.",
          "highlight": [
            "deduction"
          ],
          "translations": {
            "zh-TW": "透過簡單的推論，稽核員斷定有兩張發票被重複付款。"
          }
        }
      ],
      "synonyms": [
        "subtraction",
        "withholding",
        "inference"
      ],
      "antonyms": [
        "addition"
      ],
      "phrases": [
        "tax deduction",
        "payroll deduction",
        "logical deduction"
      ]
