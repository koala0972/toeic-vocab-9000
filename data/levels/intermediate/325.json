      "domain": "business",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "specification",
          "definition": "n. 規格；規格說明書；明確要求"
        }
      ],
      "examples": [
        {
          "en": "The engineer reviewed the specification before approving the supplier's proposal.",
          "highlight": [
            "specification"
          ],
          "translations": {
            "zh-TW": "工程師在批准供應商的提案前，先審查了規格說明書。"
          }
        },
        {
          "en": "All product specifications must be submitted to the quality team by Friday.",
          "highlight": [
            "specifications"
          ],
          "translations": {
            "zh-TW": "所有產品規格必須在週五前提交給品質團隊。"
          }
        },
        {
          "en": "Our new software meets the client's technical specification exactly as written in the contract.",
          "highlight": [
            "specification"
          ],
          "translations": {
            "zh-TW": "我們的新軟體完全符合合約中所載的客戶技術規格。"
          }
        }
      ],
      "synonyms": [
        "requirement",
        "standard",
        "criterion"
      ],
      "antonyms": [
        "ambiguity"
      ],
      "phrases": [
        "technical specification",
        "product specification",
        "meet specification"
      ]
    },
