        {
          "en": "After upgrading the software, the warehouse operates more efficiently than it did last year.",
          "highlight": [
            "more efficiently"
          ],
          "translations": {
            "zh-TW": "升級軟體後，倉庫的運作比去年更有效率。"
          }
        },
        {
          "en": "Of all departments, the procurement team works most efficiently during the year-end rush.",
          "highlight": [
            "most efficiently"
          ],
          "translations": {
            "zh-TW": "在所有部門中，採購團隊在年終旺季時的運作最具效率。"
          }
        }
      ],
      "synonyms": [
        "effectively",
        "productively",
        "smoothly"
      ],
      "antonyms": [
        "inefficiently"
      ],
      "phrases": [
        "work efficiently",
        "operate efficiently",
        "manage efficiently"
      ]
