      "id": "B1-325-004",
      "level": 325,
      "tier": "intermediate",
      "cefr": "B1",
      "toeic_score_min": 650,
      "word": "economical",
      "phonetic": "",
      "pos": [
        "adjective"
      ],
      "conjugations": {
        "comparative": "more economical",
        "superlative": "most economical"
      },
      "domain": "business",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "economical",
          "definition": "adj. 節儉的；經濟實惠的；省錢的"
        }
      ],
      "examples": [
        {
          "en": "The new printer is economical because it uses less ink per page than the old model.",
          "highlight": [
            "economical"
          ],
          "translations": {
            "zh-TW": "這台新印表機很省錢，因為每頁消耗的墨水比舊機型少。"
          }
        },
        {
          "en": "Shipping by sea is more economical than air freight for bulk orders.",
          "highlight": [
            "more economical"
          ],
          "translations": {
            "zh-TW": "對於大批訂單而言，海運比空運更經濟實惠。"
          }
        },
        {
          "en": "Of all the heating systems, the heat pump is the most economical choice for the office.",
          "highlight": [
            "most economical"
          ],
          "translations": {
            "zh-TW": "在所有暖氣系統中，熱泵是辦公室最省錢的選擇。"
          }
        }
      ],
      "synonyms": [
        "thrifty",
        "cost-effective",
        "frugal"
      ],
      "antonyms": [
        "wasteful",
        "extravagant"
      ],
      "phrases": [
        "economical with",
        "economical car",
        "economical solution"
      ]
    },
