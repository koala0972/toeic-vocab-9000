      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "whoever",
          "definition": "pron. 無論誰、任何……的人；到底是誰（引導名詞子句）"
        }
      ],
      "examples": [
        {
          "en": "Whoever leaves the office last must turn off the air conditioner.",
          "highlight": [
            "whoever"
          ],
          "translations": {
            "zh-TW": "無論誰最後離開辦公室，都必須關掉冷氣。"
          }
        },
        {
          "en": "We will hire whoever the committee recommends for the accounting role.",
          "highlight": [
            "whoever"
          ],
          "translations": {
            "zh-TW": "我們將聘請委員會推薦的任何人擔任會計職位。"
          }
        },
        {
          "en": "Whoever sent this anonymous complaint should come forward and explain.",
          "highlight": [
            "whoever"
          ],
          "translations": {
            "zh-TW": "寄出這封匿名投訴的人應該主動出面說明。"
          }
        }
      ],
      "synonyms": [
        "anyone",
        "whatever person",
        "no matter who"
      ],
      "antonyms": [
        "nobody"
      ],
      "phrases": [
        "whoever it may concern",
        "whoever you are",
        "whoever is responsible"
      ]
    },
