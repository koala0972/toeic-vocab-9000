          ],
          "translations": {
            "zh-TW": "航班延誤了三小時，但無論如何我們還是準時趕上專題演講。"
          }
        },
        {
          "en": "I hadn't prepared a speech, but anyhow the client invited me to share a few remarks, so I improvised.",
          "highlight": [
            "anyhow"
          ],
          "translations": {
            "zh-TW": "我原本沒準備演講，但不管怎樣客戶還是邀我說幾句，我就即興發言了。"
          }
        },
        {
          "en": "His desk was piled anyhow with contracts and receipts, yet he always found what he needed.",
          "highlight": [
            "anyhow"
          ],
          "translations": {
            "zh-TW": "他的辦公桌上雜亂地堆滿合約與收據，但他總能找到需要的東西。"
          }
        }
      ],
      "synonyms": [
        "anyway",
        "regardless",
        "in any case"
      ],
      "antonyms": [
        " orderly",
        "systematically"
      ],
      "phrases": [
        "anyhow versus anyway",
        "queue anyhow",
        "toss anyhow"
      ]
