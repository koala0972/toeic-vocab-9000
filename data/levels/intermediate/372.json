        {
          "en": "Heavy meals often leave me at my sleepiest during afternoon meetings.",
          "highlight": [
            "sleepiest"
          ],
          "translations": {
            "zh-TW": "豐盛的餐點常讓我在下午的會議中最昏昏欲睡。"
