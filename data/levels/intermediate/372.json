      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "sewer",
          "definition": "n. 下水道、陰溝、排水管"
        }
      ],
      "examples": [
        {
          "en": "The city council voted to upgrade the old sewer lines downtown to prevent flooding.",
          "highlight": [
            "sewer"
          ],
          "translations": {
            "zh-TW": "市議會投票通過升級市區老舊的下水道管線以防淹水。"
          }
        },
        {
          "en": "Blocked sewers caused raw waste to spill onto the streets after the heavy rainfall.",
          "highlight": [
            "sewers"
          ],
          "translations": {
            "zh-TW": "大雨過後，阻塞的下水道造成未經處理的廢水溢到街道上。"
          }
        },
        {
          "en": "A sewer inspector was trapped underground for two hours before rescue crews reached him.",
          "highlight": [
            "sewer"
          ],
          "translations": {
            "zh-TW": "一名下水道巡視員受困地下兩小時，救援隊才抵達他身邊。"
          }
        }
      ],
      "synonyms": [
        "drain",
        "wasteway",
        "conduit"
      ],
      "antonyms": [],
      "phrases": [
        "sewer system",
        "storm sewer",
        "sewer line"
      ]
