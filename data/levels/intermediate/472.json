      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "functional",
          "definition": "a. 功能的、實用的、機能的"
        }
      ],
      "examples": [
        {
          "en": "Many refugees walked for miles with only a few functional belongings.",
          "highlight": [
            "functional"
          ],
          "translations": {
            "zh-TW": "許多難民徒步走了數英里，只帶了幾件實用的物品。"
          }
        },
        {
          "en": "When functional kitchens doubled as classrooms, the school stayed open during the storm.",
          "highlight": [
            "functional"
          ],
          "translations": {
            "zh-TW": "當實用的廚房兼作教室時，這所學校在暴風雨中維持運作。"
          }
        },
        {
          "en": "Several reviewers considered the new design less pretty but more functional than the old one.",
          "highlight": [
            "functional"
          ],
          "translations": {
            "zh-TW": "幾位評論者認為新設計不如舊設計那麼漂亮，但更為實用。"
          }
        }
      ],
      "synonyms": [
        "practical",
        "usable",
        "operational"
      ],
      "antonyms": [
        "useless",
        "broken"
      ],
      "phrases": [
        "functional group",
        "functional design",
        "functional training",
        "functional medicine"
      ]
