      },
      "domain": "business",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "obligate",
          "definition": "v. 使負有義務、強制（法律或合約上）履行"
        }
      ],
      "examples": [
        {
          "en": "The signed service contract obligates the supplier to deliver parts within 48 hours.",
          "highlight": [
            "obligates"
          ],
          "translations": {
            "zh-TW": "簽署的服務合約規定供應商必須在 48 小時內交付零件。"
          }
        },
        {
          "en": "The supplier was obligated to refund the full purchase price after failing to meet the deadline.",
          "highlight": [
            "obligated"
          ],
          "translations": {
            "zh-TW": "供應商未能如期交貨，因此有義務全額退還貨款。"
          }
        },
        {
          "en": "By obligating both parties to quarterly reviews, the new agreement improves quality control.",
          "highlight": [
            "obligating"
          ],
          "translations": {
            "zh-TW": "新合約要求雙方進行季審，進而提升品質管控。"
          }
        }
      ],
      "synonyms": [
        "require",
        "compel",
        "bind"
      ],
      "antonyms": [
        "excuse",
        "release"
      ],
      "phrases": [
        "obligate to",
        "legally obligate",
        "obligate someone to",
        "be obligated to"
      ]
    },
