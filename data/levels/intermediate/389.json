      ],
      "examples": [
        {
          "en": "The HR team will oblige new interns by pairing them with experienced mentors for the first month.",
          "highlight": [
            "oblige"
          ],
          "translations": {
            "zh-TW": "人資團隊會幫新進實習生的忙，在第一個月安排他們與資深導師配對。"
          }
        },
        {
          "en": "When the urgent order arrived, support staff obliged by working through the weekend.",
          "highlight": [
            "obliged"
          ],
          "translations": {
            "zh-TW": "緊急訂單到貨時，客服人員幫忙加班處理，週末也照常工作。"
          }
        },
        {
          "en": "The contract obliges the tenant to give three months' notice before terminating the lease.",
          "highlight": [
            "obliges"
          ],
          "translations": {
            "zh-TW": "合約規定租戶在終止租約前必須提前三個月通知。"
          }
        }
      ],
      "synonyms": [
        "accommodate",
        "assist",
        "compel"
      ],
      "antonyms": [
