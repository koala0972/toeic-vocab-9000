      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "modem",
          "definition": "n. 數據機（連接電腦與網路、轉換數位訊號的裝置）"
        }
      ],
      "examples": [
        {
          "en": "The new modem supports download speeds up to one gigabit per second.",
          "highlight": [
            "modem"
          ],
          "translations": {
            "zh-TW": "這款新的數據機支援每秒高達 1 Gbps 的下載速度。"
          }
        },
        {
          "en": "IT replaced the old modems in every branch office after the recent network upgrade.",
          "highlight": [
            "modems"
          ],
          "translations": {
            "zh-TW": "在最近的網路升級之後，IT 部門更換了各分公司的舊數據機。"
          }
        },
        {
          "en": "Please restart your modem if the office internet connection drops during the day.",
          "highlight": [
            "modem"
          ],
          "translations": {
            "zh-TW": "若白天辦公室的網路斷線，請重新啟動您的數據機。"
          }
        }
      ],
      "synonyms": [
        "router",
        "broadband gateway",
        "network adapter"
      ],
      "antonyms": [],
      "phrases": [
        "cable modem",
        "reset the modem",
        "modem router",
        "modem connection"
      ]
