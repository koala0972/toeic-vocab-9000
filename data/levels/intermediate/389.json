      "level": 389,
      "tier": "intermediate",
      "cefr": "B1",
      "toeic_score_min": 650,
      "word": "lifeguard",
      "phonetic": "",
      "pos": [
        "noun"
      ],
      "conjugations": {
        "plural": "lifeguards"
      },
      "domain": "safety",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "lifeguard",
          "definition": "n. 救生員（負責泳池或海灘安全的人員）"
        }
      ],
      "examples": [
        {
          "en": "The hotel hired a certified lifeguard to watch over the guest pool during summer.",
          "highlight": [
            "lifeguard"
          ],
          "translations": {
            "zh-TW": "飯店雇用了一名持有證照的救生員，在暑假期間看管住客泳池。"
          }
        },
        {
          "en": "Two lifeguards patrol the beach from sunrise until sunset every weekend.",
          "highlight": [
            "lifeguards"
          ],
          "translations": {
            "zh-TW": "每逢週末，兩名救生員從日出到日落巡視這片海灘。"
          }
        },
        {
          "en": "If a guest is caught in a rip current, the lifeguard will signal everyone out of the water immediately.",
          "highlight": [
            "lifeguard"
          ],
          "translations": {
            "zh-TW": "若有住客遇上離岸流，救生員會立即示意所有人離開水面。"
          }
        }
      ],
      "synonyms": [
        "rescuer",
        "swim guard",
        "beach patrol"
      ],
      "antonyms": [
        "swimmer"
      ],
      "phrases": [
        "certified lifeguard",
        "lifeguard station",
        "lifeguard on duty",
        "lifeguard certification"
      ]
    },
