      "toeic_score_min": 650,
      "word": "letterhead",
      "phonetic": "",
      "pos": [
        "noun"
      ],
      "conjugations": {
        "plural": "letterheads"
      },
      "domain": "business",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "letterhead",
          "definition": "n. 信箋抬頭、印有公司名稱與地址的專用信紙"
        }
      ],
      "examples": [
        {
          "en": "Please print the contract on our company letterhead before mailing it to the client.",
          "highlight": [
            "letterhead"
          ],
          "translations": {
            "zh-TW": "請用本公司印有抬頭的信紙列印合約後寄給客戶。"
          }
        },
        {
          "en": "The law firm keeps several letterheads on file for its different branches.",
          "highlight": [
            "letterheads"
          ],
          "translations": {
            "zh-TW": "這家律師事務所為其各個分所備有數款不同的信箋抬頭。"
          }
        },
        {
          "en": "All official correspondence must carry the registered letterhead to be considered valid.",
          "highlight": [
            "letterhead"
          ],
          "translations": {
            "zh-TW": "所有官方信函必須使用註冊的信箋抬頭才能視為有效。"
          }
        }
      ],
      "synonyms": [
        "stationery",
        "notepaper",
        "company letterhead"
      ],
      "antonyms": [
        "plain paper"
      ],
      "phrases": [
        "company letterhead",
        "print on letterhead",
        "official letterhead",
        "letterhead stationery"
      ]
    },
