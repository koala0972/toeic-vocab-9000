      "phonetic": "",
      "pos": [
        "noun"
      ],
      "conjugations": {
        "plural": "mosquitoes"
      },
      "domain": "general",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "mosquito",
          "definition": "n. 蚊子（會叮咬人畜並傳播疾病的昆蟲）"
        }
      ],
      "examples": [
        {
          "en": "The resort sends staff to spray every room for mosquito control before guests arrive.",
          "highlight": [
            "mosquito"
          ],
          "translations": {
            "zh-TW": "度假村在住客抵達前，會派人對每間客房噴灑防蚊藥劑。"
          }
        },
        {
          "en": "Mosquitoes breed quickly in standing water, so the maintenance team clears the drains weekly.",
          "highlight": [
            "mosquitoes"
          ],
          "translations": {
            "zh-TW": "蚊子在積水中繁殖迅速，因此維修團隊每週清理排水溝。"
          }
        },
        {
          "en": "Health officials warn that a single mosquito can transmit dengue fever in tropical regions.",
          "highlight": [
            "mosquito"
          ],
          "translations": {
            "zh-TW": "衛生官員警告，在熱帶地區一隻蚊子就能傳播登革熱。"
          }
        }
      ],
      "synonyms": [
        "gnat",
        "midge",
        "insect"
      ],
      "antonyms": [],
      "phrases": [
        "mosquito net",
        "mosquito repellent",
        "mosquito bite",
        "mosquito control"
      ]
