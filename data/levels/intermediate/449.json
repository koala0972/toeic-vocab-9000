      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "undermine",
          "definition": "v. 暗中破壞、削弱；在...下面挖；逐漸損害"
        }
      ],
      "examples": [
        {
          "en": "Constant rumours undermine trust between teams faster than anyone realizes.",
          "highlight": [
            "undermine"
