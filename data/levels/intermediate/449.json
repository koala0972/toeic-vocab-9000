          "translations": {
            "zh-TW": "前後不一的內部備忘讓員工對新政策的信心大打折扣。"
          }
        },
        {
          "en": "By undermining the audit findings, the manager hoped to delay the public report.",
          "highlight": [
            "undermining"
          ],
          "translations": {
            "zh-TW": "這位主管藉由質疑查帳結論，企圖拖延公開報告。"
          }
        }
