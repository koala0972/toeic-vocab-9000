      "synonyms": [
        "weaken",
        "sabotage",
        "subvert"
      ],
      "antonyms": [
        "strengthen"
      ],
      "phrases": [
        "undermine confidence",
        "undermine authority",
        "undermine trust",
        "undermine support"
      ]
