      "id": "B1-358-001",
      "level": 358,
      "tier": "intermediate",
      "cefr": "B1",
      "toeic_score_min": 650,
      "word": "paraphrase",
      "phonetic": "",
      "pos": [
        "noun",
        "verb"
      ],
      "conjugations": {
        "plural": "paraphrases",
        "present_3rd": "paraphrases",
        "past": "paraphrased",
        "past_participle": "paraphrased",
        "ing": "paraphrasing"
      },
      "domain": "communication",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "paraphrase",
          "definition": "n. 改寫、意釋  v. 改寫、用不同字句表達"
        }
      ],
      "examples": [
        {
          "en": "Can you paraphrase the contract clause so the client understands it more easily?",
          "highlight": [
            "paraphrase"
          ],
          "translations": {
            "zh-TW": "你能把合約條款改寫一下，讓客戶更容易理解嗎？"
          }
        },
        {
          "en": "The lawyer paraphrased the legal jargon into plain English during the meeting.",
          "highlight": [
            "paraphrased"
          ],
          "translations": {
            "zh-TW": "律師在會議中把法律術語改寫成淺顯的英文。"
          }
        },
        {
          "en": "Paraphrasing the original text without citing the source may still count as plagiarism.",
          "highlight": [
            "Paraphrasing"
          ],
          "translations": {
            "zh-TW": "改寫原文而未註明出處仍可能構成抄襲。"
          }
        }
      ],
      "synonyms": [
        "rephrase",
        "reword",
        "restate"
      ],
      "antonyms": [
        "quote"
      ],
      "phrases": [
        "paraphrase a sentence",
        "paraphrase the passage",
        "close paraphrase"
      ]
    },
