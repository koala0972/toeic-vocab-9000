      "id": "B1-327-001",
      "level": 327,
      "tier": "intermediate",
      "cefr": "B1",
      "toeic_score_min": 650,
      "word": "automate",
      "pos": [
        "verb"
      ],
      "conjugations": {
        "present_3rd": "automates",
        "past": "automated",
        "past_participle": "automated",
        "ing": "automating"
      },
      "domain": "business",
      "translations": [
        {
          "lang": "zh-TW",
          "lang_word": "automate",
          "definition": "v. 使自動化、以機器取代人力操作"
        }
      ],
      "examples": [
        {
          "en": "The factory plans to automate its assembly line next year.",
          "highlight": [
            "automate"
          ],
          "translations": {
            "zh-TW": "這家工廠計畫明年將裝配線自動化。"
          }
        },
        {
          "en": "We automated the invoicing process to reduce human error.",
          "highlight": [
            "automated"
          ],
          "translations": {
            "zh-TW": "我們將開立發票的流程自動化，以減少人為錯誤。"
          }
        },
        {
          "en": "By automating routine tasks, employees can focus on creative work.",
          "highlight": [
            "automating"
          ],
          "translations": {
            "zh-TW": "藉由將例行工作自動化，員工可以專注於創意性業務。"
          }
        }
      ],
      "synonyms": [
        "mechanize",
        "computerize",
        "robotize"
      ],
      "antonyms": [
        "manual"
      ],
      "phrases": [
        "automate a process",
        "automate tasks",
        "fully automated"
      ]
    },
