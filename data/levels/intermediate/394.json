        {
          "lang": "zh-TW",
          "lang_word": "daytime",
          "definition": "n. 白天、日間  adj. 日間的、白天的"
        }
      ],
      "examples": [
        {
          "en": "The call center operates only during daytime hours to reduce labor costs.",
          "highlight": [
