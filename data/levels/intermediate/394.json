        {
          "en": "Daytimes in summer are extremely long in northern Europe.",
          "highlight": [
            "daytimes"
          ],
          "translations": {
            "zh-TW": "北歐夏季的日間時間非常長。"
          }
        },
        {
          "en": "The daytime temperature in the warehouse often exceeds 32 degrees Celsius.",
          "highlight": [
            "daytime"
          ],
          "translations": {
            "zh-TW": "倉庫白天的氣溫經常超過攝氏32度。"
          }
        }
